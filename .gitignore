# ==============================================================================
# Humidyne Labs / Humiditron `epd-font` v1.0.7 Repository .gitignore
# ==============================================================================
# Python Virtual Environments & Bytecode
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class

# Generated Build & Distribution Output Directories (recreated by scripts/*/*.bat)
# Note: static_ttfs/, metadata/, and ascii_patches/ live inside build/
build/
dist/
*.egg-info/

# Explicitly keep the root hand-tuned optical patch manifest tracked in Git!
!epd_font_patches.json

# OS & Editor Artifacts
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/
