{
  "repository": "https://github.com/Humidyne-Labs/epd-font",
  "repository_name": "epd-font",
  "project_tagline": "UFO 3 + DesignSpace 5.1 1-bit bi-level EPD typography system for embedded displays",
  "organization": "Humidyne Labs / Humiditron",
  "version": "2.0.0",
  "spec_id": "SPEC-EPD-FONT-001",
  "spec_revision": "1.1",
  "master_format": "UFO 3 + DesignSpace 5.1",
  "python_toolchain": "3.12 (.venv via uv)",
  "lvgl_compatibility": ">= 9.6.0 (LVGL v9+)",
  "ppem_range": [12, 14, 16, 18, 20, 24, 28, 32, 36, 40],
  "styles": ["normal", "italic", "bold", "bold-italic"],
  "modifiers": ["sans", "mono", "condensed"],
  "output_artifacts": [
    "build/ttf/*.ttf",
    "build/bdf/*.bdf",
    "build/pbm/*",
    "build/c_arrays/*.{c,h}",
    "build/metrics/*.csv",
    "build/dist/humid1_epd_vault.json.gz",
    "build/proofs/*"
  ],
  "hardware_schemes": [
    "esp32s3-N8R8-hw_scheme.json",
    "generic_hw.json"
  ]
}
