{
  "schema_version": "1.0.23",
  "scheme_id": "ereader_editorial_serif",
  "project_brand": "Humiditron E-Paper Long-Form Editorial & Field Manual Scheme",
  "description": "High-legibility IBM Plex Serif (Regular, Italic, Bold 16-32px) paired with Sans UI headers.",
  "spdx_license": "MIT AND OFL-1.1",
  "hardware_scheme": "esp32s3-N8R8-hw_scheme.json",
  "raster_config": {
    "pipeline": "raw-hinted",
    "math_backend": "auto",
    "threshold": 128,
    "gamma": 1.0,
    "normal_weight": 500,
    "bold_weight": 800,
    "italic_weight": 600,
    "patches_file": "font_icon_epd_patches.json",
    "ascii_patches_dir": "build/ascii_patches",
    "sheet_debug": false,
    "char_debug": false,
    "debug_stages": false
  },
  "output_branding": {
    "symbol_prefix": "humid1_",
    "primary_header": "humid1_fonts.h",
    "compat_header": "epd_fonts.h",
    "default_font": "humid1_font_plex_sans_normal_14",
    "semantic_roles": {
      "HUMID1_FONT_UI_MICRO": "humid1_font_plex_sans_normal_12",
      "HUMID1_FONT_UI_BODY": "humid1_font_plex_sans_normal_14",
      "HUMID1_FONT_UI_SUBTITLE": "humid1_font_plex_sans_bold_14",
      "HUMID1_FONT_UI_TITLE": "humid1_font_plex_sans_bold_16",
      "HUMID1_FONT_UI_HEADER": "humid1_font_plex_sans_bold_16",
      "HUMID1_FONT_TELEMETRY_SM": "humid1_font_plex_sans_bold_14",
      "HUMID1_FONT_TELEMETRY_MD": "humid1_font_plex_serif_bold_20",
      "HUMID1_FONT_TELEMETRY_LG": "humid1_font_plex_serif_bold_24",
      "HUMID1_FONT_TELEMETRY_XL": "humid1_font_plex_serif_bold_32",
      "HUMID1_FONT_TERMINAL": "humid1_font_plex_sans_bold_16",
      "HUMID1_ICON_FA7_DEFAULT": "humid1_font_plex_sans_bold_16",
      "HUMID1_ICON_LUCIDE_DEFAULT": "humid1_font_plex_sans_bold_16",
      "HUMID1_ICON_PHOSPHOR_DEFAULT": "humid1_font_plex_sans_bold_16",
      "HUMID1_ICON_TABLER_DEFAULT": "humid1_font_plex_sans_bold_16"
    }
  },
  "character_sets": {
    "ascii_printable": {
      "description": "Standard Printable ASCII (U+0020..U+007E)",
      "ranges": "0x0020-0x007E"
    },
    "latin1_units": {
      "description": "Scientific & Technical & Environmental Units (°, ±, ², ³, µ, ·, ×, ÷)",
      "ranges": "0x00B0,0x00B1,0x00B2,0x00B3,0x00B5,0x00B7,0x00D7,0x00F7"
    },
    "arrows_punctuation": {
      "description": "General Punctuation, En/Em Dashes, Bullet, Permille, Arrows (←↑→↓)",
      "ranges": "0x2013,0x2014,0x2018,0x2019,0x201C,0x201D,0x2022,0x2026,0x2030,0x2190-0x2193"
    }
  },
  "strikes": [
    {
      "family": "serif",
      "style": "normal",
      "sizes": [
        16,
        18,
        20,
        24,
        28,
        32
      ],
      "char_sets": [
        "ascii_printable",
        "latin1_units",
        "arrows_punctuation"
      ],
      "kerning": true,
      "fallback": "humid1_font_plex_sans_normal_{size}"
    },
    {
      "family": "serif",
      "style": "italic",
      "sizes": [
        16,
        18,
        20,
        24,
        28,
        32
      ],
      "char_sets": [
        "ascii_printable",
        "latin1_units",
        "arrows_punctuation"
      ],
      "kerning": true,
      "fallback": "humid1_font_plex_serif_normal_{size}"
    },
    {
      "family": "serif",
      "style": "bold",
      "sizes": [
        16,
        18,
        20,
        24,
        28,
        32
      ],
      "char_sets": [
        "ascii_printable",
        "latin1_units",
        "arrows_punctuation"
      ],
      "kerning": true,
      "fallback": "humid1_font_plex_serif_normal_{size}"
    },
    {
      "family": "sans",
      "style": "normal",
      "sizes": [
        12,
        14,
        16
      ],
      "char_sets": [
        "ascii_printable",
        "latin1_units"
      ],
      "kerning": true,
      "fallback": null
    },
    {
      "family": "sans",
      "style": "bold",
      "sizes": [
        14,
        16
      ],
      "char_sets": [
        "ascii_printable",
        "latin1_units"
      ],
      "kerning": true,
      "fallback": "humid1_font_plex_sans_normal_{size}"
    }
  ]
}
