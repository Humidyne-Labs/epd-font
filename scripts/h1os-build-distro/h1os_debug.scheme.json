{
  "schema_version": "1.0.22",
  "scheme_id": "h1os_epd_v1_debug_single_font",
  "project_brand": "Humidyne Labs H1OS Single-Font Full-Pipeline Debug & Verification Scheme",
  "description": "Fast v1.0.22 single-font (IBM Plex Sans Normal @ 16px low-detail & 38px high-detail) verification scheme with pipeline='all-debug', sheet_debug=true, char_debug=true, and debug_stages=true.",
  "spdx_license": "MIT AND OFL-1.1",
  "hardware_scheme": "esp32s3-N8R8-hw_scheme.json",
  "raster_config": {
    "pipeline": "all-debug",
    "math_backend": "auto",
    "threshold": 128,
    "gamma": 1.0,
    "normal_weight": 500,
    "bold_weight": 800,
    "italic_weight": 600,
    "patches_file": "font_icon_epd_patches.json",
    "ascii_patches_dir": "build/h1os_debug/ascii_patches",
    "sheet_debug": true,
    "char_debug": true,
    "debug_stages": true
  },
  "output_branding": {
    "symbol_prefix": "humid1_",
    "primary_header": "humid1_fonts.h",
    "compat_header": "h1os_fonts.h",
    "default_font": "humid1_font_plex_sans_normal_16",
    "semantic_roles": {
      "HUMID1_FONT_UI_BODY": "humid1_font_plex_sans_normal_16",
      "HUMID1_FONT_UI_HEADER": "humid1_font_plex_sans_normal_38"
    }
  },
  "character_sets": {
    "ascii_printable": {
      "description": "Standard Printable ASCII (U+0020..U+007E)",
      "ranges": "0x0020-0x007E"
    }
  },
  "strikes": [
    {
      "family": "sans",
      "style": "normal",
      "sizes": [
        16,
        38
      ],
      "char_sets": [
        "ascii_printable"
      ],
      "kerning": true,
      "fallback": null
    }
  ]
}
