{
  "schema_version": "1.0.23",
  "scheme_id": "terminus_retro_terminal",
  "project_brand": "Humiditron Terminus v4.49.1 Crisp Console & Debug Terminal Scheme",
  "description": "Bit-exact Terminus bitmap-derived TrueType scheme for serial consoles, boot logs, and retro UIs.",
  "spdx_license": "MIT AND OFL-1.1",
  "hardware_scheme": "esp32s3-N8R8-hw_scheme.json",
  "raster_config": {
    "pipeline": "raw-hinted",
    "math_backend": "auto",
    "threshold": 128,
    "gamma": 1.0,
    "normal_weight": 500,
    "bold_weight": 800,
    "italic_weight": 600,
    "patches_file": "font_icon_epd_patches.json",
    "ascii_patches_dir": "build/ascii_patches",
    "sheet_debug": false,
    "char_debug": false,
    "debug_stages": false
  },
  "output_branding": {
    "symbol_prefix": "humid1_",
    "primary_header": "humid1_fonts.h",
    "compat_header": "epd_fonts.h",
    "default_font": "humid1_font_terminus_bold_14",
    "semantic_roles": {
      "HUMID1_FONT_UI_MICRO": "humid1_font_terminus_normal_12",
      "HUMID1_FONT_UI_BODY": "humid1_font_terminus_bold_14",
      "HUMID1_FONT_UI_SUBTITLE": "humid1_font_terminus_bold_14",
      "HUMID1_FONT_UI_TITLE": "humid1_font_terminus_bold_16",
      "HUMID1_FONT_UI_HEADER": "humid1_font_terminus_bold_20",
      "HUMID1_FONT_TELEMETRY_SM": "humid1_font_terminus_bold_14",
      "HUMID1_FONT_TELEMETRY_MD": "humid1_font_terminus_bold_20",
      "HUMID1_FONT_TELEMETRY_LG": "humid1_font_terminus_bold_24",
      "HUMID1_FONT_TELEMETRY_XL": "humid1_font_terminus_bold_32",
      "HUMID1_FONT_TERMINAL": "humid1_font_terminus_normal_16",
      "HUMID1_ICON_FA7_DEFAULT": "humid1_font_terminus_bold_16",
      "HUMID1_ICON_LUCIDE_DEFAULT": "humid1_font_terminus_bold_16",
      "HUMID1_ICON_PHOSPHOR_DEFAULT": "humid1_font_terminus_bold_16",
      "HUMID1_ICON_TABLER_DEFAULT": "humid1_font_terminus_bold_16"
    }
  },
  "character_sets": {
    "ascii_printable": {
      "description": "Standard Printable ASCII (U+0020..U+007E)",
      "ranges": "0x0020-0x007E"
    },
    "latin1_units": {
      "description": "Scientific & Technical & Environmental Units (°, ±, ², ³, µ, ·, ×, ÷)",
      "ranges": "0x00B0,0x00B1,0x00B2,0x00B3,0x00B5,0x00B7,0x00D7,0x00F7"
    },
    "greek_scientific": {
      "description": "Greek Telemetry & Scientific Symbols (Δ, Ω, α, β, γ, δ, θ, λ, μ, π, σ, τ, φ, ω)",
      "ranges": "0x0394,0x03A9,0x03B1-0x03B5,0x03B8,0x03BB,0x03BC,0x03C0,0x03C3,0x03C4,0x03C6,0x03C9"
    },
    "arrows_punctuation": {
      "description": "General Punctuation, En/Em Dashes, Bullet, Permille, Arrows (←↑→↓)",
      "ranges": "0x2013,0x2014,0x2018,0x2019,0x201C,0x201D,0x2022,0x2026,0x2030,0x2190-0x2193"
    }
  },
  "strikes": [
    {
      "family": "terminus",
      "style": "normal",
      "sizes": [
        12,
        14,
        16,
        18,
        20,
        22,
        24,
        28,
        32
      ],
      "char_sets": [
        "ascii_printable",
        "latin1_units",
        "greek_scientific",
        "arrows_punctuation"
      ],
      "kerning": false,
      "fallback": null
    },
    {
      "family": "terminus",
      "style": "bold",
      "sizes": [
        12,
        14,
        16,
        18,
        20,
        22,
        24,
        28,
        32
      ],
      "char_sets": [
        "ascii_printable",
        "latin1_units",
        "greek_scientific",
        "arrows_punctuation"
      ],
      "kerning": false,
      "fallback": "humid1_font_terminus_normal_{size}"
    }
  ]
}
