{
  "schema_version": "1.0.23",
  "scheme_id": "ui_balanced",
  "project_brand": "Humiditron General Embedded GUI Balanced Scheme",
  "description": "Balanced UI typography scheme (IBM Plex Sans 12-24px + Mono 14-20px + Lucide UI icons).",
  "spdx_license": "MIT AND OFL-1.1",
  "hardware_scheme": "esp32s3-N8R8-hw_scheme.json",
  "raster_config": {
    "pipeline": "raw-hinted",
    "math_backend": "auto",
    "threshold": 128,
    "gamma": 1.0,
    "normal_weight": 500,
    "bold_weight": 800,
    "italic_weight": 600,
    "patches_file": "font_icon_epd_patches.json",
    "ascii_patches_dir": "build/ascii_patches",
    "sheet_debug": false,
    "char_debug": false,
    "debug_stages": false
  },
  "output_branding": {
    "symbol_prefix": "humid1_",
    "primary_header": "humid1_fonts.h",
    "compat_header": "epd_fonts.h",
    "default_font": "humid1_font_plex_sans_normal_14",
    "semantic_roles": {
      "HUMID1_FONT_UI_MICRO": "humid1_font_plex_sans_normal_12",
      "HUMID1_FONT_UI_BODY": "humid1_font_plex_sans_normal_14",
      "HUMID1_FONT_UI_SUBTITLE": "humid1_font_plex_sans_bold_14",
      "HUMID1_FONT_UI_TITLE": "humid1_font_plex_sans_bold_16",
      "HUMID1_FONT_UI_HEADER": "humid1_font_plex_sans_bold_20",
      "HUMID1_FONT_TELEMETRY_SM": "humid1_font_plex_mono_normal_14",
      "HUMID1_FONT_TELEMETRY_MD": "humid1_font_plex_mono_bold_20",
      "HUMID1_FONT_TELEMETRY_LG": "humid1_font_plex_mono_bold_24",
      "HUMID1_FONT_TELEMETRY_XL": "humid1_font_plex_mono_bold_24",
      "HUMID1_FONT_TERMINAL": "humid1_font_plex_mono_bold_16",
      "HUMID1_ICON_FA7_DEFAULT": "humid1_icon_lucide_regular_16",
      "HUMID1_ICON_LUCIDE_DEFAULT": "humid1_icon_lucide_regular_16",
      "HUMID1_ICON_PHOSPHOR_DEFAULT": "humid1_icon_lucide_regular_16",
      "HUMID1_ICON_TABLER_DEFAULT": "humid1_icon_lucide_regular_16"
    }
  },
  "character_sets": {
    "ascii_printable": {
      "description": "Standard Printable ASCII (U+0020..U+007E)",
      "ranges": "0x0020-0x007E"
    },
    "latin1_units": {
      "description": "Scientific & Technical & Environmental Units (°, ±, ², ³, µ, ·, ×, ÷)",
      "ranges": "0x00B0,0x00B1,0x00B2,0x00B3,0x00B5,0x00B7,0x00D7,0x00F7"
    },
    "lucide_core": {
      "description": "Lucide v1.67.0 Core Embedded UI & Sensor Icons",
      "vendor": "icon_lucide",
      "icons": [
        "activity",
        "alert-triangle",
        "award",
        "battery",
        "battery-charging",
        "battery-full",
        "battery-low",
        "battery-medium",
        "battery-warning",
        "bell",
        "bluetooth",
        "check",
        "chevron-down",
        "chevron-left",
        "chevron-right",
        "chevron-up",
        "clock",
        "cloud",
        "cloud-rain",
        "cpu",
        "database",
        "droplet",
        "droplets",
        "eye",
        "flame",
        "gauge",
        "globe",
        "hard-drive",
        "heart",
        "home",
        "info",
        "layers-2",
        "lock",
        "menu",
        "moon",
        "power",
        "radio",
        "refresh-cw",
        "search",
        "server",
        "settings",
        "shield",
        "sliders",
        "sun",
        "terminal",
        "thermometer",
        "trending-up",
        "usb",
        "user",
        "volume-2",
        "wifi",
        "wind",
        "x",
        "zap"
      ],
      "ranges": "0xE01D,0xE028,0xE053-0xE057,0xE05E,0xE063,0xE070,0xE072-0xE075,0xE087,0xE08A,0xE08F,0xE09E,0xE0B4,0xE0B5,0xE0DF,0xE0E5,0xE0EB,0xE0F6,0xE0FC,0xE10A,0xE148,0xE153,0xE154,0xE159,0xE167,0xE178,0xE17C,0xE182,0xE19D,0xE1A1,0xE1A8,0xE1AA,0xE1B2,0xE1D8,0xE1FB,0xE1FE,0xE202"
    }
  },
  "strikes": [
    {
      "family": "sans",
      "style": "normal",
      "sizes": [
        12,
        14,
        16,
        20,
        24
      ],
      "char_sets": [
        "ascii_printable",
        "latin1_units"
      ],
      "kerning": true,
      "fallback": null
    },
    {
      "family": "sans",
      "style": "bold",
      "sizes": [
        12,
        14,
        16,
        20,
        24
      ],
      "char_sets": [
        "ascii_printable",
        "latin1_units"
      ],
      "kerning": true,
      "fallback": "humid1_font_plex_sans_normal_{size}"
    },
    {
      "family": "sans",
      "style": "italic",
      "sizes": [
        14,
        16,
        20
      ],
      "char_sets": [
        "ascii_printable",
        "latin1_units"
      ],
      "kerning": true,
      "fallback": "humid1_font_plex_sans_normal_{size}"
    },
    {
      "family": "mono",
      "style": "normal",
      "sizes": [
        14,
        16,
        20
      ],
      "char_sets": [
        "ascii_printable",
        "latin1_units"
      ],
      "kerning": false,
      "fallback": "humid1_font_plex_sans_normal_{size}"
    },
    {
      "family": "icon_lucide",
      "style": "regular",
      "sizes": [
        16,
        20
      ],
      "char_sets": [
        "lucide_core"
      ],
      "kerning": false,
      "fallback": null
    },
    {
      "family": "mono",
      "style": "bold",
      "sizes": [
        14,
        16,
        20,
        24
      ],
      "char_sets": [
        "ascii_printable",
        "latin1_units"
      ],
      "kerning": false,
      "fallback": "humid1_font_plex_sans_bold_{size}"
    }
  ]
}
