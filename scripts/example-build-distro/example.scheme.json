{
  "schema_version": "1.0.23",
  "scheme_id": "example_general_distro",
  "project_brand": "Humidyne Labs / Humiditron General Embedded Example Distribution",
  "description": "General-purpose embedded 1-bpp typography & icon distribution example (Sans, Mono, Terminus, Lucide, Phosphor).",
  "spdx_license": "MIT AND OFL-1.1",
  "hardware_scheme": "generic_hw.json",
  "raster_config": {
    "pipeline": "raw-hinted",
    "math_backend": "auto",
    "threshold": 128,
    "gamma": 1.0,
    "normal_weight": 500,
    "bold_weight": 800,
    "italic_weight": 600,
    "patches_file": "font_icon_epd_patches.json",
    "ascii_patches_dir": "build/example/ascii_patches",
    "sheet_debug": false,
    "char_debug": false,
    "debug_stages": false
  },
  "output_branding": {
    "symbol_prefix": "humid1_",
    "primary_header": "humid1_fonts.h",
    "compat_header": "epd_fonts.h",
    "default_font": "humid1_font_plex_sans_normal_14",
    "semantic_roles": {
      "HUMID1_FONT_UI_MICRO": "humid1_font_terminus_normal_12",
      "HUMID1_FONT_UI_BODY": "humid1_font_plex_sans_normal_14",
